# PostgreSQL (used by docker-compose; override for local dev)
DATABASE_URL=postgresql+asyncpg://pstimer:pstimer@localhost:5432/pstimer

# Security: MUST be set to a random string >= 32 chars in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Service
APP_NAME=PlayStation Club
DEBUG=false
BASE_URL=http://localhost:8000

# CORS (comma-separated origins allowed to call the backend)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Analytics / history retention
CLUB_TIMEZONE=Asia/Bishkek
HISTORY_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=6

# Telegram bot (read-only: notifications + station overview). Leave empty to
# disable. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL=15

# Bootstrap admin (used only when no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
