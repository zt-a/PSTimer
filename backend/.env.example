# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Used for local dev. In Docker it is overridden by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://pstimer:pstimer@localhost:5432/pstimer

# ── Security ─────────────────────────────────────────────────────────────────
# If empty, the app generates a random secret once and persists it:
#   * Docker  -> named volume `backendsecrets` (/app/.secrets)
#   * local   -> backend/.jwt_secret
# For multi-instance setups set an explicit random string >= 32 chars.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Service ──────────────────────────────────────────────────────────────────
APP_NAME=PlayStation Club
DEBUG=false
BASE_URL=http://localhost:8000

# CORS origins (comma-separated). "*" = allow any origin (no domain needed).
# Frontend is served same-origin by nginx, so this mostly matters only for
# direct browser access to the API on :8000.
CORS_ORIGINS=*

# ── Analytics / history retention ────────────────────────────────────────────
CLUB_TIMEZONE=Asia/Bishkek
HISTORY_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=6

# ── Telegram bot (optional, read-only) ───────────────────────────────────────
# Leave empty to disable. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL=15

# ── Bootstrap admin (used only when no admin exists yet) ─────────────────────
# CHANGE THE PASSWORD BEFORE FIRST START.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin