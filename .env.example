# Per-server overrides for docker compose.
# Copy to `.env` in the project root:  cp .env.example .env
# Compose loads this file automatically. Every value is optional.

# ── Ports (host side) ────────────────────────────────────────────────────────
# 80 = the classic web port; change if it is taken on your server.
HTTP_PORT=80
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=pstimer

# ── Bootstrap admin (only used when no admin exists yet) ─────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Security ─────────────────────────────────────────────────────────────────
# Leave empty to auto-generate a secret persisted on the `backendsecrets`
# volume (tokens survive restarts). Set a random string >= 32 chars to pin it.
JWT_SECRET=

# ── Telegram bot (optional, read-only) ───────────────────────────────────────
# Get a token from @BotFather. Empty = bot disabled.
TELEGRAM_BOT_TOKEN=

# ── Service ──────────────────────────────────────────────────────────────────
APP_NAME=PlayStation Club
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Analytics / history retention ────────────────────────────────────────────
CLUB_TIMEZONE=Asia/Bishkek
HISTORY_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=6